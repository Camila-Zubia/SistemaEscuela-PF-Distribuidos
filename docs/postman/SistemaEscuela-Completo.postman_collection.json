    {
      "name": "2 - Reglas de negocio",
      "description": "Lo que el sistema NO debe permitir. Corre despues de la carpeta 1.",
      "item": [
        {
          "name": "Aval ya resuelto -> 409",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{gateway}}/api/aval/resolver",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idEntrega\": \"{{idEntrega}}\",\n  \"idTutor\": \"T001\",\n  \"aprobado\": false\n}"
            }
